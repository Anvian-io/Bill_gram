# Server Configuration
NODE_ENV=production
PORT=3001

# Database Configuration
DATABASE_PATH=./database/shopkeeper.db

# JWT Configuration
JWT_SECRET=your_development_secret_key_change_this_in_production
JWT_EXPIRY=24h

# App Configuration
APP_NAME=Shopkeeper App
APP_VERSION=1.0.0

# Backup Configuration
BACKUP_DIR=./backups
MAX_BACKUPS=10

# Features
ENABLE_GST=true
ENABLE_QR=true
ENABLE_MULTIPLE_SHOPS=false

# Windows: C:\Users\[Username]\AppData\Roaming\Shopkeeper\shopkeeper.db
# macOS: /Users/[Username]/Library/Application Support/Shopkeeper/shopkeeper.db
# Linux: /home/[username]/.config/Shopkeeper/shopkeeper.db