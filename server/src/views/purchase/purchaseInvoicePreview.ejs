<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Purchase Invoice – exact SS MARKETING style</title>
  <style>
    /* RESET / GLOBAL */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background: #ffffff;
      display: flex;
      justify-content: center;
      padding: 24px 12px;
      font-family: 'Arial', 'Helvetica', sans-serif;
    }
    .invoice {
      max-width: 1120px;
      width: 100%;
      background: white;
      border: 1.5px solid #2c2c2c;
      box-shadow: 0 8px 16px rgba(0,0,0,0.1);
    }

    /* HEADER top section – seller & buyer side by side */
    .header-split {
      display: flex;
      align-items: stretch;
    }
    .seller-panel {
      flex: 1.2;
      padding: 10px 10px 6px 10px;
      
      display: flex;
      gap: 8px;
    }
    .logo-placeholder {
      width: 80px;
      height: 80px;
      border: 1px solid #a0a0a0;
      background: #f4f4f4;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      color: #555;
      flex-shrink: 0;
    }
    .logo-placeholder img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
    .seller-details {
      line-height: 1.4;
      font-size: 11px;
    }
    .seller-details h2 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.5px;
      margin-bottom: 2px;
      text-transform: uppercase;
    }
    .seller-details p {
      margin: 2px 0;
    }

    .buyer-panel {
      border-left: 1px solid #7f7f7f;
      flex: 1;
      padding: 10px 10px 6px 12px;
      line-height: 1.4;
      font-size: 11px;
    }
    .buyer-panel h3 {
      font-size: 18px;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 2px;
    }
    .buyer-panel p {
      margin: 2px 0;
    }

    /* ===== FIXED QR SECTION ===== */
    .qr-section {
      width: 105px;
      border-left: 1px solid #7f7f7f;

      display: flex;
      flex-direction: column;      /* stack children vertically */
      justify-content: center;     /* center vertically */
      align-items: center;         /* center horizontally */
      padding: 0;
    }
    .qr-box {
      width: 90px;
      height: 90px;
      border: 1px solid #444;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      color: #5e5e5e;
      margin: 0;
    }
    .qr-box img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* TITLE ROW – Tax Invoice + meta */
    .title-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 6px 10px;
      border-bottom: 1px solid #7f7f7f;
      background: #f8f8f8;
      font-weight: 600;
    }
    .title-row .title {
      font-size: 20px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }
    .inv-meta {
      font-size: 13px;
      text-align: right;
      line-height: 1.4;
    }
    .inv-meta span {
      font-weight: 400;
      margin-left: 16px;
    }

    /* MAIN ITEMS TABLE */
    table.items {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 10.5px;
    }
    table.items th {
      background: #ececec;
      font-weight: 700;
      border: 1px solid #4b4b4b;
      padding: 5px 3px;
      text-align: left;
      vertical-align: middle;
    }
    table.items td {
      border: 1px solid #4b4b4b;
      padding: 4px 3px;
      vertical-align: top;
    }
    .right {
      text-align: right;
      padding-right: 5px;
    }

    /* SUMMARY TABLE (exact 8 columns) */
    table.summary {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      font-size: 10.5px;
      border: 1px solid #4b4b4b;
    }
    table.summary th {
      background: #ececec;
      border: 1px solid #4b4b4b;
      padding: 5px 3px;
      font-weight: 700;
      text-align: right;
    }
    table.summary td {
      border: 1px solid #4b4b4b;
      padding: 5px 3px;
      text-align: right;
    }

    /* FOOTER with remarks and signature */
    .footer-split {
      display: flex;
      border-top: 1px solid #4b4b4b;
    }
    .remarks-box {
      width: 70%;
      padding: 8px 10px;
      font-size: 10.5px;
      border-right: 1px solid #4b4b4b;
      line-height: 1.4;
    }
    .signature-box {
      width: 30%;
      min-height: 100px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      padding: 8px 5px 5px 5px;
      text-align: center;
    }
    .signature-box .sign-place {
      max-width: 120px;
      max-height: 50px;
      margin-bottom: 8px;
    }
    .signature-box img {
      max-width: 100%;
      max-height: 50px;
      object-fit: contain;
    }
    .signature-box p {
      border-top: 1px solid #4b4b4b;
      width: 100%;
      padding-top: 6px;
      font-weight: 600;
      font-size: 11px;
      margin-top: 4px;
    }

    /* continue tag (exactly as in sample) */
    .continue-row {
      text-align: left;
      font-weight: 700;
      font-style: italic;
      padding: 2px 8px;
      border-top: 1px dashed #333;
      border-bottom: 1px solid #4b4b4b;
      background: #f9f9f9;
      font-size: 11px;
    }

    /* page bottom note */
    .cheque-note {
      font-weight: 500;
      margin-bottom: 4px;
    }
  </style>
</head>
<body>
  <%
    // ----- DATA PREPARATION -----
    const items = purchase.items || [];
    const gross = Number(purchase.grossAmount || 0);
    const discountPercent = Number(purchase.discountPercent || 0);
    const discountAmount = gross * (discountPercent / 100);
    const schemeTotal = Number(purchase.scheme1 || 0);
    const damageAmount = items.reduce((sum, item) => sum + (Number(item.DQty || 0) * Number(item.rate || 0)), 0);
    const amountAdd = Number(purchase.amountAdd || 0);
    const creditAmount = Number(purchase.creditAmount || 0);
    const totalGst = Number(purchase.tax || 0);
    const roundOff = 0;
    const finalAmount = Number(purchase.finalAmount || 0);
    const gstValue = String(purchase.gstDetails || '').toLowerCase();
    const isWithGst = gstValue === '1' || gstValue.includes('with') || gstValue.includes('against');
    const invoiceTitle = isWithGst ? 'Tax Invoice' : 'Purchase Challan';

    const formatAmount = (val) => (Number(val) || 0).toFixed(2);
    const formatDate = (d) => {
      if (!d) return '';
      if (typeof d === 'string' && d.match(/^\d{4}-\d{2}-\d{2}/)) {
        let [y,m,day] = d.split('-');
        return `${day} ${['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][parseInt(m)-1]} ${y}`;
      }
      return d;
    };
  %>

  <div class="invoice">
    <!-- HEADER: seller / buyer / QR -->
    <div class="header-split">
      <!-- Seller area with optional logo -->
      <div class="seller-panel">
        <div class="logo-placeholder">
          <% if (companyLogoUrl) { %>
            <img src="<%= companyLogoUrl %>" alt="logo" />
          <% } else { %>
            LOGO
          <% } %>
        </div>
        <div class="seller-details">
          <h2><%= companyName || 'SS MARKETING' %></h2>
          <p>Address : <%= companyAddress || 'Shop No.2, Gyanyog Bldg, vithal rukhmani nagar, Dativali road. Diva [E]' %></p>
          <p>Phone : <%= companyPhone || '8097673047 / 9820626857' %></p>
          <p>GSTIN : 27FMOPS7672M1ZS</p>
          <p>FSSAI NO : 21521068000442</p>
        </div>
      </div>

      <!-- QR Code area – now perfectly centered vertically -->
      <div class="qr-section">
        <div class="qr-box">
          <% if (upiQrCode) { %>
            <img src="<%= upiQrCode %>" alt="QR" />
          <% } else { %>
            QR CODE
          <% } %>
        </div>
      </div>
      
      <!-- Buyer panel (VIJAY G STORE) -->
      <div class="buyer-panel">
        <h3><%= supplierName || 'VIJAY G STORE' %></h3>
        <p>Address : Shop No.2, Gyanyog Bldg,</p>
        <p>Address : DATIVALI, vithal rukhmani nagar, Dativali road. Diva [E]</p>
        <p>Phone : 8097673047 / 9820626857</p>
        <p>GSTIN : null</p>
        <p>FSSAI NO :</p>
      </div>
      
    </div>

    <!-- TITLE + INV NUMBER, DATE, SALESMAN -->
    <div class="title-row">
      <span class="title"><%= invoiceTitle %></span>
      <div class="inv-meta">
        <strong>Inv. No. :</strong> <%= purchase.invoiceNo || '10911' %> &nbsp;&nbsp;
        <strong>Inv Date :</strong> <%= formatDate(purchase.invoiceDate) || '02 Mar 2026' %> &nbsp;&nbsp;
        <strong>Salesman :</strong> <%= purchase.salesman || 'mr pankaj' %>
      </div>
    </div>

    <!-- ITEMS TABLE -->
    <table class="items">
      <thead>
        <tr>
          <th style="width: 3.5%">Sr</th>
          <th style="width: 7%">HSN</th>
          <th style="width: 20%">Prod Description</th>
          <th class="right" style="width: 7%">MRP</th>
          <th class="right" style="width: 7%">Bx/Qty</th>
          <th class="right" style="width: 5%">FR</th>
          <th class="right" style="width: 7%">Rate</th>
          <th class="right" style="width: 7%">Scheme</th>
          <th class="right" style="width: 8%">Amount</th>
          <th class="right" style="width: 6%">GST%</th>
          <th class="right" style="width: 7%">GST Amt</th>
          <th class="right" style="width: 8%">Net Amt</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach((item, idx) => { %>
          <tr>
            <td><%= idx + 1 %></td>
            <td><%= item?.product?.hsnSacCode || '180690' %></td>
            <td><%= item?.product?.description || 'KRZZY DAY 10 RS' %></td>
            <td class="right"><%= formatAmount(item?.batch?.mrp || 0) %></td>
            <td class="right"><%= Number(item?.mQty || 0) %>/<%= Number(item?.aQty || 0) %></td>
            <td class="right"><%= Number(item?.fQty || 0) %></td>
            <td class="right"><%= formatAmount(item?.rate || 0) %></td>
            <td class="right"><%= formatAmount(item?.schAmount || 0) %></td>
            <td class="right"><%= formatAmount(item?.totalAmount || 0) %></td>
            <td class="right"><%= Number(item?.taxRate || 0) %>%</td>
            <td class="right"><%= formatAmount(item?.taxAmount || 0) %></td>
            <td class="right"><%= formatAmount(item?.finalAmount || 0) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <!-- CONTINUE line (if needed) -->
    <% if (items.length > 0 && purchase.hasMorePages) { %>
      <div class="continue-row">Continue___</div>
    <% } %>

    <!-- SUMMARY TABLE -->
    <table class="summary">
      <thead>
        <tr>
          <th>GROSS</th>
          <th>Disc-0%</th>
          <th>Tot Sch</th>
          <th>Damage</th>
          <th>Add/Less</th>
          <th>Total Gst</th>
          <th>R/O</th>
          <th>Total Pay</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= formatAmount(gross) %></td>
          <td><%= formatAmount(discountAmount) %></td>
          <td><%= formatAmount(schemeTotal) %></td>
          <td><%= formatAmount(damageAmount) %></td>
          <td><%= formatAmount(amountAdd) %>/<%= formatAmount(creditAmount) %></td>
          <td><%= formatAmount(totalGst) %></td>
          <td><%= formatAmount(roundOff) %></td>
          <td><%= formatAmount(finalAmount) %></td>
        </tr>
      </tbody>
    </table>

    <!-- FOOTER : CHEQUE CHARGES + REMARKS + SIGNATURE -->
    <div class="footer-split">
      <div class="remarks-box">
        <div><strong>Remarks :</strong> <%= purchase.remarks || '' %></div>
        <div class="cheque-note">Cheque Return Charges Rs.500/-</div>
        <div style="margin-top: 10px; font-size: 9.5px; line-height: 1.3;">
          We hereby certify that our Registration Certificate under the GST Act 2017 is in force on the date on which sale of this goods specified in this Tax Invoice is made by us and that the transaction of sale covered by this Tax invoice has been effected by us & it shall be accounted for in the turnover of sales while filing of return and the due tax, if any payable on the sale has been paid or shall be paid.
        </div>
      </div>
      <div class="signature-box">
        <% if (signatureUrl) { %>
          <div class="sign-place"><img src="<%= signatureUrl %>" alt="signature" /></div>
        <% } else { %>
          <div class="sign-place" style="height: 35px;"></div>
        <% } %>
        <p>For <%= companyName || 'SS MARKETING' %></p>
      </div>
    </div>

    <div style="height: 2px;"></div>
  </div>
</body>
</html>