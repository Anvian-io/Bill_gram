<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Purchase Register</title>
  <style>
    /* GLOBAL RESET & BASE */
    body {
      font-family: Arial, sans-serif;
      margin: 30px;
      color: #000;
      background: #fff;
    }
    .header {
      text-align: center;
      margin-bottom: 20px;
    }
    .header h1 {
      font-size: 24px;
      margin: 0;
    }
    .info-row {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 5px;
      font-size: 14px;
    }
    .details {
      font-size: 13px;
      margin: 15px 0;
    }
    .details span.label {
      font-weight: 600;
    }

    /* TABLE STYLES */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-top: 20px;
    }

    th, td {
      border: none;
      padding: 8px 5px;
      text-align: left;
    }

    /* Header styling */
    thead th {
      background: #f2f2f2;
      font-weight: 600;
      text-align: center;
      border-top: 2px solid #000;
      border-bottom: 2px solid #000;
    }

    /* Right alignment for numeric cells */
    td.right {
      text-align: right;
    }

    /* Totals row */
    tr.total-row td {
      border-top: 2px solid #000;
      border-bottom: 2px solid #000;
    }

    .footer {
      margin-top: 20px;
      font-size: 12px;
      display: flex;
      justify-content: space-between;
    }

    thead {
      display: table-header-group;
    }
    tfoot {
      display: table-footer-group;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>Purchase Register</h1>
    <div class="info-row">
      <span>Date: <%= formatDate(dateRange.from) %> to <%= formatDate(dateRange.to) %></span>
    </div>
  </div>

  <div class="details">
    <div><span class="label">INVOICE :</span> <%= invoiceRange.start || '—' %> to <%= invoiceRange.end || '—' %></div>
    <div><span class="label">AREA :</span> <%= areas.length ? areas.join(', ') : 'All' %></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Invoice No</th>
        <th>Date</th>
        <th>Supplier</th>
        <th class="right">Amount (₹)</th>
        <th class="right">Cash</th>
        <th class="right">Cheque</th>
        <th class="right">Balance</th>
      </tr>
    </thead>
    <tbody>
      <% invoices.forEach((invoice, index) => { %>
        <tr>
          <td><%= invoice.invoiceNo %></td>
          <td><%= formatDate(invoice.invoiceDate) %></td>
          <td><%= invoice.supplierName %></td>
          <td class="right">₹<%= invoice.amount.toFixed(2) %></td>
          <td class="right"></td>
          <td class="right"></td>
          <td class="right">₹<%= invoice.balance.toFixed(2) %></td>
        </tr>
      <% }) %>
      <!-- Totals row -->
      <% if (totals) { %>
        <tr class="total-row" style="font-weight: bold; background: #f0f0f0;">
          <td colspan="3">Total <%= totals.totalInvoices %> invoices</td>
          <td class="right">₹<%= totals.totalAmount.toFixed(2) %></td>
          <td></td>
          <td></td>
          <td class="right">₹<%= totals.totalAmount.toFixed(2) %></td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <!-- Footer (Puppeteer will replace page numbers) -->
  <div class="footer">
    <span><%= user.shop_name || 'Your Shop' %></span>
    <span class="pageNumbers"></span>
  </div>
</body>
</html>