# Runtime mode
NODE_ENV=development

# JWT signing secret for login/auth tokens
JWT_SECRET=replace_with_a_long_random_secret

# Google Drive backup integration
# Leave these blank if you do not use Google Drive backup/restore.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: only needed if you run Prisma directly instead of the provided scripts.
# The app itself computes DATABASE_URL automatically at runtime.
# DATABASE_URL=file:./dev.db
