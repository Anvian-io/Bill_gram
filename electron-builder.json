{
  "appId": "com.billgram.app",
  "productName": "BillGram",
  "directories": {
    "output": "dist",
    "buildResources": "assets"
  },
  "files": [
    "client/dist/**/*",
    "electron/**/*",
    "node_modules/koffi/**/*",
    "!server/**/*",
    "!**/*.map",
    "!**/*.log"
  ],
  "extraResources": [
    {
      "from": "server",
      "to": "server",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      }
    ],
    "icon": "assets/icon.ico",
    "artifactName": "BillGram-Setup-${version}.${ext}",
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "license": "LICENSE",
    "perMachine": false,
    "deleteAppDataOnUninstall": true
  },
  "publish": {
    "provider": "generic",
    "url": "http://127.0.0.1:4000/releases"
  }
}
