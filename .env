# App Configuration
APP_NAME=Bill Gram
APP_VERSION=1.0.0
NODE_ENV=production

# Server Configuration
SERVER_PORT=3001
CLIENT_PORT=5173

# Database Configuration
DATABASE_NAME=shopkeeper.db

# JWT Configuration
JWT_SECRET=your_development_secret_key_change_this_in_production
JWT_EXPIRY=24h

# Backup Configuration
BACKUP_DIR=backups
MAX_BACKUPS=10
AUTO_BACKUP_DAYS=7

# License Configuration (Development)
LICENSE_VALIDITY=365
LICENSE_SECRET=development_license_secret
LICENSE_CHECK=false

# Features (true/false)
ENABLE_GST=true
ENABLE_QR=true
ENABLE_MULTIPLE_SHOPS=false
ENABLE_PDF_EXPORT=true
ENABLE_EXCEL_EXPORT=true

UPDATE_SERVER_URL=https://bill-gram-1.onrender.com/releases
UPLOAD_API_KEY=bgram_render_8f4e2a91c7d63b05e1f9a4c2